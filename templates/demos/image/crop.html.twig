{% extends 'demos/live_demo.html.twig' %}

{% set demo_package_name = 'Image' %}
{# A social card cuts its text at 120 characters: the one-sentence description fits whole #}
{% set demo_social_description = demo.description %}

{% block meta %}
    {{ parent() }}
    {# A Turbo snapshot cannot bring the cropper back to life: the back button renders the page again #}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block demo_breadcrumb %}
    <a href="{{ url('app_image') }}">Image</a>
{% endblock %}

{% block demo_container %}
    <div class="UploadDemoShell max-w-[1140px] mx-auto mb-12">
        <twig:Browser id="demo" class="shadow-blur shadow-blur--rainbow w-full" frameClass="">
            {# Every answer replaces this frame only: the page and its scroll stay #}
            <turbo-frame id="crop-demo">
                <div class="UploadStage CropDemo" data-controller="crop-demo">
                    <div class="UploadStage_container UploadStage_container--wide">
                        <header class="CropDemo_header">
                            <h3 id="crop-demo-title" class="CropDemo_title">Your photos</h3>
                            <p>Add up to {{ max }} photos. Drag to reorder: the first one is your main photo.</p>
                        </header>

                        <ol
                            class="CropDemo_grid"
                            aria-labelledby="crop-demo-title"
                            data-action="dragover->crop-demo#over dragleave->crop-demo#leave drop->crop-demo#drop"
                        >
                            {% for photo in gallery %}
                                {{ include('demos/image/_photo_slot.html.twig', {position: loop.index}) }}
                            {% endfor %}

                            {% if not full %}
                                <li class="CropDemo_add">
                                    {{ form_start(upload, {action: path('app_demo_image_crop'), attr: {id: 'crop-demo-upload', 'data-action': 'symfony--ux-upload--upload:complete->crop-demo#submit'}}) }}
                                        {{ form_widget(upload.photo, {label_drop_files: 'Add a photo'}) }}
                                    {{ form_end(upload) }}
                                </li>

                                {# The other free places open the same field #}
                                {% set free = max - gallery|length - 1 %}
                                {% for place in free > 0 ? 1..free : [] %}
                                    <li class="CropDemo_free" aria-hidden="true">
                                        <label for="{{ upload.photo.vars.id }}"><span><twig:ux:icon name="lucide:plus" /></span></label>
                                    </li>
                                {% endfor %}
                            {% endif %}
                        </ol>

                        {% if upload.vars.errors|length > 0 or upload.photo.vars.errors|length > 0 %}
                            <div class="CropDemo_errors" role="alert">
                                {{ form_errors(upload) }}
                                {{ form_errors(upload.photo) }}
                            </div>
                        {% endif %}

                        <footer class="CropDemo_footer">
                            {% if not full %}
                                {# A real photo to crop: each one goes to the next free place #}
                                {% set samples = ['/uploads/gros-caillou-phone.jpg', '/uploads/col-de-saint-bonnet-phone.jpg', '/uploads/cherries-phone.jpg'] %}
                                <button
                                    type="button"
                                    class="UploadStage_sample"
                                    data-controller="upload-samples"
                                    data-upload-samples-kind-value="photo"
                                    data-upload-samples-url-value="{{ samples[gallery|length % samples|length] }}"
                                    data-upload-samples-for-value=".CropDemo_add input[type=file]"
                                    data-action="upload-samples#fill"
                                >Use a sample photo</button>
                                {# Without JavaScript, the photo travels with the form #}
                                <button type="submit" form="crop-demo-upload" class="UploadStage_submit CropDemo_submit">Add this photo</button>
                            {% endif %}
                            <p class="CropDemo_notice">This public server deletes your photos 10 minutes after their upload.</p>
                        </footer>
                    </div>

                    {# A photo dropped on another one: the new order travels with this form #}
                    <form method="post" action="{{ path('app_demo_image_crop') }}" data-crop-demo-target="order" hidden>
                        <input type="hidden" name="order">
                    </form>

                    {% if editing %}
                        {# Open as it renders: Cropper.js measures the dialog open #}
                        <twig:Dialog id="crop-demo" open>
                            {{ include('demos/image/_crop_dialog.html.twig', {photo: editing, main: editing.name == gallery[0].name}) }}
                        </twig:Dialog>
                    {% endif %}
                </div>
            </turbo-frame>
        </twig:Browser>
    </div>

    <section class="UploadDemoStory">
        <div class="max-w-[1400px] mx-auto px-6 md:px-12">
            <twig:Code:CodeWithExplanationRow
                filename="src/Form/CropDemoPhotoForm.php"
                :lineStart="28"
                :lineEnd="35"
                reversed
                sticky
            >
## Upload: the photo travels first

`UploadType` sends the photo as soon as it is dropped: in one request up to
1 MB, in 1 MB chunks above. The `photos` uploader accepts a JPEG, PNG or WebP
file of 5 MB at most.

When the upload completes, a small Stimulus controller submits the form. The
form carries a signed reference to the photo, not the photo. The answer adds a
card for the photo, and opens the cropper in a dialog.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="src/Service/CropDemoPhotos.php"
                :lineStart="42"
                :lineEnd="53"
                sticky
            >
## Keep the original, once

`move()` copies the photo to `public/uploads/crops/`, under the id of its
upload: a form sent twice finds it there already. IPX reads its originals
from `public/`.

The original never changes. A crop is a URL, not a file: change the selection,
and no file is written. This public server still deletes each photo 10 minutes
after its upload.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="src/Form/CropDemoSelectionForm.php"
                :lineStart="28"
                :lineEnd="44"
                reversed
                sticky
            >
## Crop: a square, four numbers

`CropperType` shows the photo through IPX, turned upright by `autoorient`: a
phone often stores the rotation of a photo in its EXIF data. With `aspectRatio`
set to `1`, the selection moves and grows, and stays square.

The form receives `x`, `y`, `width` and `height`. PHP never opens the photo:
no GD, no Imagick. The controller keeps the largest square of the box, checks
that it fits in the photo, and records it for the card.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="templates/demos/image/_crop_dialog.html.twig"
                sticky
            >
## A dialog, open as it renders

The demo lives in a Turbo Frame. Once the photo is on the server, the frame
comes back with this content in a `Dialog` component rendered `open`: the
dialog opens as its controller connects, before Cropper.js measures it.

Serve the crop: only the frame is replaced. The dialog closes, the card shows
the crop, and the page keeps its scroll.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="templates/demos/image/_served_photo.html.twig"
                reversed
                sticky
            >
## Serve: one tag, every width

In its card, the `ux:image` component writes a `srcset` of IPX URLs. The `ipx`
operations apply to every candidate: `autoorient`, then `extract`, then the
resize to the square of the candidate.

IPX cuts the selection before it resizes it, so every width shows the same
crop. The browser picks one candidate, and IPX encodes it in AVIF or WebP when
the browser accepts them.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="ipx/.platform.app.yaml"
                sticky
            >
## IPX, next to the app on Upsun

IPX is a Node.js server. It runs as a second application of the project,
from the `ipx/` directory. The router sends `/_ipx/` to it, and caches what it
returns.

IPX fetches the originals from the Symfony application, over the internal
network of the environment: a preview environment serves its own photos. IPX
signs no URL, so it only allows the operations the templates use.
            </twig:Code:CodeWithExplanationRow>

            <twig:Code:CodeWithExplanationRow
                filename="compose.yml"
                :lineStart="19"
                :lineEnd="27"
                reversed
                sticky
            >
## Locally, one more Docker service

The Flex recipe of `symfony/ux-ipx-image` adds this service to `compose.yml`.
IPX reads `public/` from the disk, and the Symfony CLI exposes its port as
`IPX_HOST` and `IPX_PORT` for the DSN of `.env`.

Your application sets `UX_IMAGE_DSN`. This site keeps Cloudinary for its other
images: the demo reads `CROP_DEMO_IMAGE_DSN`, which points at `/_ipx/` in
production, and only its pages render through IPX.
            </twig:Code:CodeWithExplanationRow>
        </div>
    </section>
{% endblock %}

{% block aside %}
    <aside class="bg-subtle mt-12">
        <div class="max-w-[1400px] mx-auto p-6 md:p-12">
            <nav aria-label="More demos">
                <twig:Demo:DemoGrid :demos="related" compact />
            </nav>
        </div>
    </aside>
{% endblock %}
