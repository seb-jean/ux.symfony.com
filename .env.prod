# Cloudinary fetches the originals from ux.symfony.com.
# api_secret signs each URL; CLOUDINARY_SECRET is a host env var.
UX_IMAGE_DSN=cloudinary://fnmfvsxv?origin=https://ux.symfony.com&api_secret=${CLOUDINARY_SECRET}

# The Upload, Crop & Serve demo renders through IPX, run next to the app: ipx/.platform.app.yaml.
# The router sends /_ipx/ to it, and caches what it returns.
CROP_DEMO_IMAGE_DSN=ipx://${SYMFONY_APPLICATION_DEFAULT_ROUTE_HOST:-ux.symfony.com}/_ipx
